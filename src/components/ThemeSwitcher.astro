---
const themeOptions = [
  { value: "system", label: "System" },
  { value: "light", label: "Hell" },
  { value: "dark", label: "Dunkel" },
]
---

<li class="theme-switcher">
  <button
    type="button"
    class="theme-toggle"
    aria-label="Darstellung umschalten"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span class="theme-glyph" aria-hidden="true"></span>
    <span class="sr-only">Darstellung öffnen</span>
  </button>
  <div class="theme-menu" hidden>
    {
      themeOptions.map((option) => (
        <button type="button" class="theme-option" data-theme-value={option.value} aria-pressed="false">
          {option.label}
        </button>
      ))
    }
  </div>
</li>

<script>
  const storageKey = "theme-preference"
  const root = document.documentElement
  const media = window.matchMedia("(prefers-color-scheme: dark)")

  const switcher = document.querySelector<HTMLLIElement>(".theme-switcher")
  const toggle = switcher?.querySelector<HTMLButtonElement>(".theme-toggle")
  const menu = switcher?.querySelector<HTMLDivElement>(".theme-menu")

  function readPreference(): string {
    try {
      const value = localStorage.getItem(storageKey)
      if (value === "light" || value === "dark" || value === "system") {
        return value
      }
    } catch {
      // Storage can be blocked by browser privacy settings.
    }
    return "system"
  }

  function applyTheme(preference: string): void {
    const activeTheme = preference === "system" ? (media.matches ? "dark" : "light") : preference
    root.setAttribute("data-theme", activeTheme)
    root.style.colorScheme = activeTheme
  }

  function markActiveOption(preference: string): void {
    menu?.querySelectorAll<HTMLButtonElement>("button[data-theme-value]").forEach((option) => {
      const isActive = option.dataset.themeValue === preference
      option.setAttribute("aria-pressed", isActive ? "true" : "false")
      option.classList.toggle("is-active", isActive)
    })
  }

  function setMenuOpen(isOpen: boolean): void {
    if (!menu || !toggle) {
      return
    }
    menu.hidden = !isOpen
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false")
  }

  media.addEventListener("change", () => {
    if (readPreference() === "system") {
      applyTheme("system")
    }
  })

  if (switcher && toggle && menu) {
    markActiveOption(readPreference())

    menu.querySelectorAll<HTMLButtonElement>("button[data-theme-value]").forEach((option) => {
      option.addEventListener("click", () => {
        const choice = option.dataset.themeValue ?? "system"
        try {
          localStorage.setItem(storageKey, choice)
        } catch {
          // Preference cannot be persisted; apply it for this page view only.
        }
        applyTheme(choice)
        markActiveOption(choice)
        setMenuOpen(false)
      })
    })

    toggle.addEventListener("click", () => setMenuOpen(menu.hidden))

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !switcher.contains(event.target)) {
        setMenuOpen(false)
      }
    })

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuOpen(false)
      }
    })
  }
</script>

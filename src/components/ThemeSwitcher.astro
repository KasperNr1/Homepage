---
const themeOptions = [
  { value: "system", label: "System" },
  { value: "light", label: "Hell" },
  { value: "dark", label: "Dunkel" },
]
---

<li class="theme-switcher">
  <button
    type="button"
    class="theme-toggle"
    popovertarget="theme-menu"
    aria-label="Darstellung umschalten"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span class="theme-glyph" aria-hidden="true"></span>
    <span class="sr-only">Darstellung öffnen</span>
  </button>
  <div id="theme-menu" class="theme-menu" popover>
    {
      themeOptions.map((option) => (
        <button type="button" class="theme-option" data-theme-value={option.value} aria-pressed="false">
          {option.label}
        </button>
      ))
    }
  </div>
</li>

<script>
  import { initThemeSwitcher } from "../scripts/theme"

  initThemeSwitcher()
</script>

---
import ThemeSwitcher from "./ThemeSwitcher.astro"
import type { NavigationLink } from "../config/site"

interface Props {
  brand: string
  brandHref: string
  links: NavigationLink[]
}

const { brand, brandHref, links } = Astro.props
---

<nav class="site-navigation">
  <span class="nav-name"><a href={brandHref}>{brand}</a></span>
  <button
    class="nav-toggle"
    type="button"
    aria-controls="site-navigation-links"
    aria-expanded="false"
    aria-label="Navigation öffnen"
    hidden
  >
    <span class="nav-toggle-icon" aria-hidden="true"></span>
  </button>
  <ul id="site-navigation-links" class="nav-links">
    {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    <ThemeSwitcher />
  </ul>
</nav>

<script>
  import { initNavigation } from "../scripts/navigation"

  initNavigation()
</script>

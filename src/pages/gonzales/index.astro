---
import { getEntry, render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"

const project = await getEntry("projects", "gonzales")
if (!project) {
  throw new Error("Missing content entry: projects/gonzales")
}

const { Content } = await render(project)
---

<BaseLayout title="Gonzales" shell="gonzales">
  <section id="hero">
    <h1>{project.data.title}</h1>
    <p class="tagline">{project.data.description}</p>
  </section>

  <section>
    <h2>Über die App</h2>
    <div class="about-body">
      <Content />
      <p>
        Datenschutzerklärung: <a href="/policies/gonzales">Gonzales-Datenschutz ansehen</a>
      </p>
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"
import { siteConfig } from "../config/site"
import portrait from "../assets/Portrait.jpeg"

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)
---

<BaseLayout title={siteConfig.name}>
  <section id="hero">
    <h1>{siteConfig.name}</h1>
    <p class="tagline">
      Softwareentwickler &amp; Dozent<br />
      Ich entwickle Tools, die aus eigenen Problemen entstehen und auch anderen helfen könnten
    </p>
  </section>

  <section id="about">
    <h2>Über mich</h2>
    <div class="about-grid">
      <Image
        class="portrait"
        src={portrait}
        alt={`Porträt von ${siteConfig.owner}`}
        widths={[240, 480]}
        sizes="(max-width: 620px) 220px, 240px"
        loading="eager"
      />
      <div class="about-body">
        <p>
          Ich studiere Informatik im Bachelor und arbeite aktuell an meinem Abschluss. Anschließend
          plane ich, mit einem Master weiterzumachen.
        </p>
        <p>
          Parallel zum Studium arbeite ich als Dozent und Lehrer. Dabei unterrichte ich Schüler in <em
            >Mathematik</em
          >, die kurz vor ihrem <em>Realschulabschluss</em> oder <em>Abitur</em> stehen und motiviert sind,
          mit sehr guten Noten zu bestehen. Auch für angehende Informatiker habe ich bereits Online-Kurse
          durchgeführt, um sie auf erfolgreiche Abschlussprüfungen in den Bereichen Anwendungsentwicklung
          und Systemintegration vorzubereiten.
        </p>
      </div>
    </div>
    <a class="project-link" href="/about">Mehr über mich &rarr;</a>
  </section>

  <section id="projects">
    <h2>Projekte</h2>
    <div class="project-grid">
      {
        projects.map((project) => (
          <article class="project-card">
            <div class="project-header">
              <h3>{project.data.title}</h3>
              {project.data.techStack.map((tech) => (
                <span class="badge">{tech}</span>
              ))}
            </div>
            <p>{project.data.description}</p>
            <a class="project-link" href={`/projects/${project.id}`}>
              Projekt ansehen &rarr;
            </a>
          </article>
        ))
      }
    </div>
    <a class="project-link" href="/projects">Alle Projekte ansehen &rarr;</a>
  </section>
</BaseLayout>

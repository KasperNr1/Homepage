---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"
import Timeline from "../components/Timeline.astro"
import {
  academicWork,
  certificates,
  education,
  events,
  experience,
  facts,
  skillGroups,
  volunteering,
  type TimelineEntry,
} from "../config/cv"
import { siteConfig } from "../config/site"
import portrait from "../assets/portrait-placeholder.png"

const projectEntries: TimelineEntry[] = (await getCollection("projects"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((project) => ({
    period: project.data.date.toLocaleDateString("de-DE", { month: "2-digit", year: "numeric" }),
    title: project.data.title,
    organisation: project.data.techStack.join(" · "),
    description: project.data.description,
  }))
---

<BaseLayout
  title="Über mich"
  description="Werdegang, Erfahrung und Schwerpunkte von Matti Magnus Bos."
>
  <section id="hero">
    <h1>Über mich</h1>
    <p class="tagline">Informatikstudent, Softwareentwickler und Dozent aus Dornstetten.</p>
  </section>

  <section>
    <h2>Hintergrund</h2>
    <div class="about-grid">
      <Image
        class="portrait"
        src={portrait}
        alt={`Porträt von ${siteConfig.owner}`}
        widths={[240, 480]}
        sizes="(max-width: 620px) 220px, 240px"
        loading="eager"
      />
      <div class="about-body">
        <p>
          Ich bin Softwareentwickler und stehe kurz vor dem Abschluss meines Informatikstudiums an
          der DHBW in Horb. Neben der objektorientierten Entwicklung mit Java, C# und Python reizt
          mich vor allem, komplexere Lösungen eigenständig aufzubauen.
        </p>
        <p>
          Genauso wichtig ist mir der Wissenstransfer: Ich arbeite neue Teammitglieder ein,
          unterrichte Mathematik und bereite angehende Fachinformatiker auf ihre Abschlussprüfungen
          vor. Was ich baue, entsteht meist aus einem eigenen Problem heraus.
        </p>
      </div>
    </div>
  </section>

  <section>
    <h2>Ausbildung</h2>
    <Timeline entries={education} />
  </section>

  <section>
    <h2>Erfahrung</h2>
    <Timeline entries={experience} />
  </section>

  <section>
    <h2>Studien- und Abschlussarbeiten</h2>
    <Timeline entries={academicWork} />
  </section>

  <section>
    <h2>Projekte</h2>
    <Timeline entries={projectEntries} />
    <a class="project-link" href="/#projects">Alle Projekte ansehen &rarr;</a>
  </section>

  <section>
    <h2>Kenntnisse</h2>
    <div class="skill-groups">
      {
        skillGroups.map((group) => (
          <div class="skill-group">
            <h3 class="skill-label">{group.label}</h3>
            <p class="skill-items">
              {group.items.map((item) => (
                <span class="badge">{item}</span>
              ))}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Engagement</h2>
    <Timeline entries={volunteering} />
  </section>

  <section>
    <h2>Hackathons und Events</h2>
    <Timeline entries={events} />
  </section>

  <section>
    <h2>Zertifikate</h2>
    <Timeline entries={certificates} />
  </section>

  <section>
    <h2>Steckbrief</h2>
    <aside class="metadata-card" aria-label="Steckbrief">
      <ul class="metadata-list">
        {
          facts.map((fact) => (
            <li>
              {fact.label}
              <br />
              <strong>{fact.value}</strong>
            </li>
          ))
        }
      </ul>
    </aside>
    <a class="project-link" href="/contact">Kontakt aufnehmen &rarr;</a>
  </section>
</BaseLayout>

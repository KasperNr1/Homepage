---
import { getCollection, render, type CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import BaseLayout from "../../layouts/BaseLayout.astro"

export async function getStaticPaths() {
  const projects = await getCollection("projects")
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}

interface Props {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const { title, description, date, techStack, hero, heroAlt, action, download, install, changelog, status } =
  project.data
const { Content } = await render(project)
const isExternalLink = (href: string) => href.startsWith("http")
const cta = action ?? download
const releaseDate = date.toLocaleDateString("de-DE", { dateStyle: "long" })
---

<BaseLayout title={title} description={description} mainClass="project-main">
  <section id="hero">
    <h1>{title}</h1>
    <p class="tagline">{description}</p>
    <p class="project-header">
      {techStack.map((tech) => <span class="badge">{tech}</span>)}
    </p>
  </section>

  <div class="download-rail">
    <aside class="download-card" aria-labelledby="download-heading">
      <h2 id="download-heading">Beziehen</h2>
      {
        cta ? (
          <a
            class="download-button"
            href={cta.href}
            target={isExternalLink(cta.href) ? "_blank" : undefined}
            rel={isExternalLink(cta.href) ? "noopener" : undefined}
          >
            {cta.label}
          </a>
        ) : (
          <p class="download-button is-pending">{status ?? "Noch nicht verfügbar"}</p>
        )
      }
      {action?.note && <p class="download-note">{action.note}</p>}

      <ul class="metadata-list download-meta">
        <li>Veröffentlicht<br /><strong>{releaseDate}</strong></li>
        {status && cta && <li>Status<br /><strong>{status}</strong></li>}
        <li>Technik<br /><strong>{techStack.join(", ")}</strong></li>
        {
          download && (
            <li>
              Bezugsquelle
              <br />
              <a
                href={download.href}
                target={isExternalLink(download.href) ? "_blank" : undefined}
                rel={isExternalLink(download.href) ? "noopener" : undefined}
              >
                {download.label}
              </a>
            </li>
          )
        }
      </ul>
    </aside>
  </div>

  <section>
    <h2>Über das Projekt</h2>
    <Image class="project-hero" src={hero} alt={heroAlt ?? title} loading="eager" />
    <div class="about-body">
      <Content />
    </div>
  </section>

  {
    install && (
      <section id="installation">
        <h2>Installation</h2>
        <div class="about-body">
          {install.intro && <p>{install.intro}</p>}
          {install.command && (
            <pre class="install-command"><code>{install.command}</code></pre>
          )}
          {install.steps && (
            <ol class="install-steps">
              {install.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          )}
          {install.note && <p class="install-note">{install.note}</p>}
        </div>
      </section>
    )
  }

  {
    changelog && (
      <section id="changelog">
        <h2>Versionshistorie</h2>
        <ol class="changelog">
          {changelog.map((release) => (
            <li class="changelog-entry">
              <div class="changelog-head">
                <h3>{release.version}</h3>
                {release.date && (
                  <time datetime={release.date.toISOString()}>
                    {release.date.toLocaleDateString("de-DE", { dateStyle: "long" })}
                  </time>
                )}
              </div>
              <ul class="changelog-changes">
                {release.changes.map((change) => (
                  <li>{change}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section>
    <h2>Details</h2>
    <div class="about-body">
      <p><a href="/projects">&larr; Alle Projekte</a></p>
    </div>
  </section>
</BaseLayout>

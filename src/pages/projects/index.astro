---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import BaseLayout from "../../layouts/BaseLayout.astro"

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)
---

<BaseLayout
  title="Projekte"
  description="Portfolio von Matti Magnus Bos: Tools und Apps, die aus eigenen Problemen entstanden sind."
>
  <section id="hero">
    <h1>Projekte</h1>
    <p class="tagline">
      Tools und Apps, die aus einem eigenen Problem entstanden sind und auch anderen helfen könnten.
    </p>
  </section>

  <section>
    <h2>Portfolio</h2>
    <div class="portfolio">
      {
        projects.map((project) => {
          const isExternal = project.data.download?.href.startsWith("http") ?? false

          return (
            <article class="portfolio-entry">
              <p class="portfolio-date">
                <time datetime={project.data.date.toISOString()}>
                  {project.data.date.toLocaleDateString("de-DE", {
                    month: "long",
                    year: "numeric",
                  })}
                </time>
              </p>

              {project.data.coverImage && (
                <Image
                  class="project-cover"
                  src={project.data.coverImage}
                  alt={project.data.title}
                />
              )}

              <div class="project-header">
                <h3>
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h3>
                {project.data.techStack.map((tech) => (
                  <span class="badge">{tech}</span>
                ))}
              </div>

              <p class="portfolio-description">{project.data.description}</p>

              <p class="portfolio-links">
                <a class="project-link" href={`/projects/${project.id}`}>
                  Dokumentation ansehen &rarr;
                </a>
                {project.data.download && (
                  <a
                    class="project-link"
                    href={project.data.download.href}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener" : undefined}
                  >
                    {project.data.download.label} &rarr;
                  </a>
                )}
                {!project.data.download && project.data.status && (
                  <span class="project-link muted">{project.data.status}</span>
                )}
              </p>
            </article>
          )
        })
      }
    </div>
  </section>
</BaseLayout>

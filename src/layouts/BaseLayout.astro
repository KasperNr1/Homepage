---
import SiteNavigation from "../components/SiteNavigation.astro"
import SiteFooter from "../components/SiteFooter.astro"
import { shells, siteConfig, type ShellName } from "../config/site"
import { themeBootstrapScript } from "../scripts/theme-bootstrap"
import "../styles/shell.css"
import "../styles/global.css"

interface Props {
  title: string
  description?: string
  shell?: ShellName
}

const { title, description, shell = "site" } = Astro.props
const { titleSuffix, brand, brandHref, navigation, footer, noindex } = shells[shell]

const pageTitle = title === titleSuffix ? title : `${title} | ${titleSuffix}`
const pageDescription = description ?? shells[shell].description
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url)
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={titleSuffix} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    <meta name="twitter:card" content="summary" />

    {/* Applies the stored theme before first paint so the page never flashes the wrong palette. */}
    <script is:inline set:html={themeBootstrapScript} />
  </head>
  <body>
    <SiteNavigation brand={brand} brandHref={brandHref} links={navigation} />
    <main>
      <slot />
    </main>
    <SiteFooter links={footer} />
  </body>
</html>
